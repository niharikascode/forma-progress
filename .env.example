DATABASE_PATH=.data/forma.sqlite
# Hosted libsql/Turso database (overrides DATABASE_PATH), e.g. libsql://name-org.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Optional, legacy. Visitors now sign up and log in with their own accounts.
# While set, the first account created with this password on the sign-up page
# ("Moving over the original workspace?") takes over the original single-user data.
# Remove it once the original workspace has been claimed.
APP_PASSWORD=
